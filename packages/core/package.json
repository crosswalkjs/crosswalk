{
  "name": "@crosswalkjs/core",
  "version": "0.1.0",
  "description": "Headless core for Crosswalk: the map document, schemas, operators and evaluator.",
  "keywords": [
    "json",
    "mapping",
    "transform",
    "data-mapping",
    "schema",
    "etl"
  ],
  "license": "MIT",
  "author": "James Mann",
  "homepage": "https://crosswalkjs.github.io/crosswalk/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crosswalkjs/crosswalk.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/crosswalkjs/crosswalk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
