{
  "name": "crosswalk",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/canvas && tsc -p playground && tsc -p e2e",
    "playground": "vite playground",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "5.4.21",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
