    },
    {
      "operator": "text.substring",
      "inputs": [
        "abcdef",
        -2
      ],
      "expected": "ef",
      "note": "A negative start counts from the end."
    },
    {
      "operator": "text.left",
      "inputs": [
        "abcdef",
        2.7
      ],
      "expected": "ab",
      "note": "Fractional counts round toward zero."
    },
    {
      "operator": "text.length",
      "inputs": [
        null
      ],
      "expected": 0,
      "note": "null reads as empty text."
    },
    {
      "operator": "convert.toText",
      "inputs": [
        2.5
      ],
      "expected": "2.5",
      "note": "A number's text is the shortest that reads back as the same number."
    },
    {
      "operator": "convert.toText",
      "inputs": [
        0.1
      ],
      "expected": "0.1"
    },
    {
      "operator": "logic.equal",
      "inputs": [
        true,
        "true"
      ],
      "expected": true,
      "note": "Not both numeric, so compared as text."
    },
    {
      "operator": "math.add",
      "inputs": [
        1,
        null
      ],
      "expected": {
        "$error": true
      },
      "note": "null isn't a number."
    },
    {
      "operator": "logic.isNumber",
      "inputs": [
        "١٢"
      ],
      "expected": false,
      "note": "Only ASCII digits count, not other scripts' digits."
    },
    {
      "operator": "convert.toText",
      "inputs": [
        1e+20
      ],
      "expected": "100000000000000000000",
      "note": "Plain digits below 1e21."
    },
    {
      "operator": "convert.toText",
      "inputs": [
        1e+21
      ],
      "expected": "1e+21",
      "note": "From 1e21 up, an exponent."
    },
    {
      "operator": "convert.toText",
      "inputs": [
        1e-06
      ],
      "expected": "0.000001",
      "note": "Plain digits from 1e-6."
    },
    {
      "operator": "convert.toText",
      "inputs": [
        1e-07
      ],
      "expected": "1e-7",
      "note": "Below 1e-6, an exponent."
    },
    {
      "operator": "convert.toText",
      "inputs": [
        -1.5e-09
      ],
      "expected": "-1.5e-9"
    },
    {
      "operator": "convert.toText",
      "inputs": [
        123456789012
      ],
      "expected": "123456789012"
    },
    {
      "operator": "convert.lookup",
      "inputs": [
        "M",
        {
          "M": "Male",
          "F": "Female"
        }
      ],
      "expected": "Male"
