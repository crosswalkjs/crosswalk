    {
      "operator": "convert.lookup",
      "inputs": [
        "X",
        {
          "M": "Male",
          "F": "Female"
        }
      ],
      "expected": {
        "$absent": true
      },
      "note": "No match and no fallback leaves the field out."
    },
    {
      "operator": "convert.lookup",
      "inputs": [
        "X",
        {
          "M": "Male",
          "F": "Female"
        },
        "Unknown"
