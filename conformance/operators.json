{
  "description": "Built-in operator behaviour. See README.md for the format.",
  "value": [
    {
      "operator": "text.concat",
      "inputs": [
        "Ana",
        " ",
        "Silva"
      ],
      "expected": "Ana Silva"
    },
    {
      "operator": "text.concat",
      "inputs": [
        "a",
        1,
        true,
        null
      ],
      "expected": "a1true",
      "note": "Numbers and booleans read as text; null reads as empty text."
    },
    {
      "operator": "text.concat",
      "inputs": [
        "a",
        {
          "$absent": true
        }
      ],
      "expected": {
        "$absent": true
      },
      "note": "A missing input makes the output missing."
    },
    {
      "operator": "text.upper",
      "inputs": [
        "Crème"
      ],
      "expected": "CRÈME",
      "note": "Case changes are locale-independent."
    },
    {
      "operator": "text.lower",
      "inputs": [
        "ÀBC"
      ],
      "expected": "àbc"
    },
    {
      "operator": "text.trim",
      "inputs": [
        "  x y  "
      ],
      "expected": "x y"
    },
    {
      "operator": "text.length",
      "inputs": [
        "héllo"
      ],
      "expected": 5
    },
    {
      "operator": "text.length",
      "inputs": [
        12.5
      ],
      "expected": 4,
      "note": "A number's length is the length of its text."
    },
    {
      "operator": "text.left",
      "inputs": [
        "+351917777777",
        4
      ],
      "expected": "+351"
    },
    {
      "operator": "text.left",
      "inputs": [
        "ab",
        5
      ],
      "expected": "ab",
      "note": "Asking for more characters than there are gives the whole text."
    },
    {
      "operator": "text.left",
      "inputs": [
        "abc",
        -1
      ],
      "expected": "",
      "note": "A negative count gives empty text."
    },
    {
      "operator": "text.right",
      "inputs": [
        "abcdef",
        2
      ],
      "expected": "ef"
    },
    {
      "operator": "text.right",
      "inputs": [
        "ab",
        0
      ],
      "expected": ""
    },
    {
      "operator": "text.substring",
      "inputs": [
        "abcdef",
        2
      ],
      "expected": "cdef",
      "note": "Start is 0-based; without a length, the rest of the text."
    },
    {
      "operator": "text.substring",
      "inputs": [
        "abcdef",
        1,
        3
      ],
      "expected": "bcd"
    },
    {
      "operator": "text.replace",
      "inputs": [
        "a-b-c",
        "-",
        "+"
      ],
      "expected": "a+b+c",
      "note": "Every occurrence is replaced, not just the first."
    },
    {
      "operator": "text.left",
      "inputs": [
        "abc",
        "x"
      ],
      "expected": {
        "$error": true
      },
      "note": "A count that isn't a number is an error."
    },
    {
      "operator": "math.add",
      "inputs": [
        1,
        "2",
        3.5
      ],
      "expected": 6.5,
      "note": "Numeric text adds as a number."
    },
    {
      "operator": "math.add",
      "inputs": [
        1,
        "abc"
      ],
      "expected": {
        "$error": true
      }
    },
    {
      "operator": "math.add",
      "inputs": [
        1,
        true
      ],
      "expected": 2,
      "note": "true reads as 1, false as 0."
    },
    {
      "operator": "math.subtract",
      "inputs": [
        10,
        4
      ],
      "expected": 6
    },
    {
      "operator": "math.multiply",
      "inputs": [
        2,
        3,
        4
      ],
      "expected": 24
    },
    {
      "operator": "math.divide",
      "inputs": [
        7,
        2
      ],
      "expected": 3.5
    },
    {
      "operator": "math.divide",
      "inputs": [
        1,
        0
      ],
      "expected": {
        "$error": true
      },
      "note": "Dividing by zero is an error."
    },
    {
      "operator": "math.modulo",
      "inputs": [
        7,
        3
      ],
      "expected": 1
    },
    {
      "operator": "math.round",
      "inputs": [
        2.5
      ],
      "expected": 3,
      "note": "Halves round away from zero."
    },
    {
      "operator": "math.round",
      "inputs": [
        -2.5
      ],
      "expected": -3
    },
    {
      "operator": "math.round",
      "inputs": [
        2.345,
        2
      ],
      "expected": 2.35
    },
    {
      "operator": "math.round",
      "inputs": [
        1.005,
        2
      ],
      "expected": 1.01,
      "note": "Rounds the decimal value as written, not its binary approximation."
    },
    {
      "operator": "math.round",
      "inputs": [
        1234,
        -2
      ],
      "expected": 1200,
      "note": "Negative decimals round to tens, hundreds and so on."
    },
    {
      "operator": "math.round",
      "inputs": [
        1.5,
        0.5
      ],
      "expected": {
        "$error": true
      },
      "note": "Decimals must be a whole number."
    },
    {
      "operator": "math.abs",
      "inputs": [
        -3
      ],
      "expected": 3
    },
    {
      "operator": "math.min",
      "inputs": [
        3,
        "1",
        2
      ],
      "expected": 1
    },
    {
      "operator": "math.max",
      "inputs": [
        3,
        "10",
        2
      ],
      "expected": 10
    },
    {
      "operator": "logic.equal",
      "inputs": [
        "351",
        351
      ],
      "expected": true,
      "note": "Compared as numbers when both sides are numeric."
    },
    {
      "operator": "logic.equal",
      "inputs": [
        "1.0",
        "1"
      ],
      "expected": true
    },
    {
      "operator": "logic.equal",
      "inputs": [
        "a",
        "A"
      ],
      "expected": false,
      "note": "Text comparison is case-sensitive."
    },
    {
      "operator": "logic.equal",
      "inputs": [
        null,
        ""
      ],
      "expected": true,
      "note": "null reads as empty text."
    },
    {
      "operator": "logic.notEqual",
      "inputs": [
        "a",
        "b"
      ],
      "expected": true
    },
    {
      "operator": "logic.greaterThan",
      "inputs": [
        "10",
        "9"
      ],
      "expected": true,
      "note": "Numeric, so 10 > 9."
    },
    {
      "operator": "logic.greaterThan",
      "inputs": [
        "10",
        "9a"
      ],
      "expected": false,
      "note": "Not both numeric, so compared as text: \"10\" < \"9a\"."
    },
    {
      "operator": "logic.greaterThan",
      "inputs": [
        "b",
        "a"
      ],
      "expected": true
    },
    {
      "operator": "logic.greaterOrEqual",
      "inputs": [
        2,
        2
      ],
      "expected": true
    },
    {
      "operator": "logic.lessThan",
      "inputs": [
        "B",
        "a"
      ],
      "expected": true,
      "note": "Text is compared by character code, so capitals sort before lower case."
    },
    {
      "operator": "logic.lessOrEqual",
      "inputs": [
        3,
        2
      ],
      "expected": false
    },
    {
      "operator": "logic.equal",
      "inputs": [
        "0x10",
        16
      ],
      "expected": false,
      "note": "Only plain decimal text is numeric, so \"0x10\" is text."
    },
    {
      "operator": "logic.and",
      "inputs": [
        true,
        "true",
        1
      ],
      "expected": true,
      "note": "true, \"true\" and non-zero numbers are true."
    },
    {
      "operator": "logic.and",
      "inputs": [
        true,
        false
      ],
      "expected": false
    },
    {
      "operator": "logic.or",
      "inputs": [
        false,
        0,
        "false"
      ],
      "expected": false
    },
    {
      "operator": "logic.or",
      "inputs": [
        false,
        2
      ],
      "expected": true
    },
    {
      "operator": "logic.not",
      "inputs": [
        true
      ],
      "expected": false
    },
    {
      "operator": "logic.not",
      "inputs": [
        "false"
      ],
      "expected": true
    },
    {
      "operator": "logic.not",
      "inputs": [
        "yes"
      ],
      "expected": {
        "$error": true
      },
      "note": "Only true, false, their text and numbers read as true or false."
    },
    {
      "operator": "logic.isNumber",
      "inputs": [
        "4050"
      ],
      "expected": true
    },
    {
      "operator": "logic.isNumber",
      "inputs": [
        " 12.5 "
      ],
      "expected": true,
      "note": "Surrounding spaces are allowed."
    },
    {
      "operator": "logic.isNumber",
      "inputs": [
        "-3.2E-2"
      ],
      "expected": true
    },
    {
      "operator": "logic.isNumber",
      "inputs": [
        ".5"
      ],
      "expected": true
    },
    {
      "operator": "logic.isNumber",
      "inputs": [
        "N/A"
      ],
      "expected": false
    },
    {
      "operator": "logic.isNumber",
      "inputs": [
        ""
      ],
      "expected": false
    },
    {
      "operator": "logic.isNumber",
      "inputs": [
        "0x10"
      ],
      "expected": false
    },
    {
      "operator": "logic.isNumber",
      "inputs": [
        "Infinity"
      ],
      "expected": false
    },
    {
      "operator": "logic.isNumber",
      "inputs": [
        true
      ],
      "expected": false,
      "note": "Booleans aren't numbers, even though they convert to one."
    },
    {
      "operator": "logic.exists",
      "inputs": [
        {
          "$absent": true
        }
      ],
      "expected": false
    },
    {
      "operator": "logic.exists",
      "inputs": [
        null
      ],
      "expected": true,
      "note": "null is a value."
    },
    {
      "operator": "logic.exists",
      "inputs": [
        0
      ],
      "expected": true
    },
    {
      "operator": "convert.toNumber",
      "inputs": [
        "12.5"
      ],
      "expected": 12.5
    },
    {
      "operator": "convert.toNumber",
      "inputs": [
        true
      ],
      "expected": 1
    },
    {
      "operator": "convert.toNumber",
      "inputs": [
        "12abc"
      ],
      "expected": {
        "$error": true
      }
    },
    {
      "operator": "convert.toText",
      "inputs": [
        12
      ],
      "expected": "12"
    },
    {
      "operator": "convert.toText",
      "inputs": [
        null
      ],
      "expected": ""
    },
    {
      "operator": "convert.toText",
      "inputs": [
        false
      ],
      "expected": "false"
    },
    {
      "operator": "convert.toBoolean",
      "inputs": [
        "true"
      ],
      "expected": true
    },
    {
      "operator": "convert.toBoolean",
      "inputs": [
        0
      ],
      "expected": false
    },
    {
      "operator": "convert.toBoolean",
      "inputs": [
        "yes"
      ],
      "expected": {
        "$error": true
      }
    },
    {
      "operator": "flow.onlyIf",
      "inputs": [
        true,
        "x"
      ],
      "expected": "x"
    },
    {
      "operator": "flow.onlyIf",
      "inputs": [
        false,
        "x"
      ],
      "expected": {
        "$absent": true
      },
      "note": "A false condition leaves the output missing."
    },
    {
      "operator": "flow.onlyIf",
      "inputs": [
        "true",
        5
      ],
      "expected": 5
    },
    {
      "operator": "flow.onlyIf",
      "inputs": [
        {
          "$absent": true
        },
        "x"
      ],
      "expected": {
        "$absent": true
      }
    },
    {
      "operator": "flow.ifElse",
      "inputs": [
        true,
        "a",
        "b"
      ],
      "expected": "a"
    },
    {
      "operator": "flow.ifElse",
      "inputs": [
        false,
        "a",
        "b"
      ],
      "expected": "b"
    },
    {
      "operator": "flow.ifElse",
      "inputs": [
        true,
        "a",
        {
          "$absent": true
        }
      ],
      "expected": "a",
      "note": "The branch not taken may be missing."
    },
    {
      "operator": "flow.ifElse",
      "inputs": [
        false,
        "a",
        {
          "$absent": true
        }
      ],
      "expected": {
        "$absent": true
      }
    },
    {
      "operator": "flow.ifElse",
      "inputs": [
        {
          "$absent": true
        },
        "a",
        "b"
      ],
      "expected": {
        "$absent": true
