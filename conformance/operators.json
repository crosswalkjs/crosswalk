    {
      "operator": "flow.firstOf",
      "inputs": [
        {
          "$absent": true
        },
        null
      ],
      "expected": {
        "$absent": true
      }
    },
    {
      "operator": "text.replace",
      "inputs": [
        "abc",
        "",
