<?xml version="1.0" encoding="utf-8"?>
<!-- Personal project: restore from nuget.org only, whatever the machine's own NuGet config says. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
